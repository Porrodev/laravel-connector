{
    "name": "porro/laravel-connector",
    "description": "Porro connector for Laravel: a signed, read-only report of versions, advisories, scheduler, queues, migrations and backups, plus suspicious activity and IP blocking on the site.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev/?utm_source=laravel-connector&utm_medium=packagist&utm_campaign=connectors",
    "keywords": [
        "porro",
        "laravel",
        "monitoring",
        "security"
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "porro/php-core": "^0.3.7"
    },
    "suggest": {
        "porro/filament-connector": "Adds Site health and Blocking pages to your Filament panel. Includes this package.",
        "porro/statamic-connector": "Adds a Porro section to the Statamic control panel. Includes this package."
    },
    "autoload": {
        "psr-4": {
            "Porro\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Porro\\Laravel\\PorroServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "1994/coding-standard": "^1.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Porro\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "ci:quality": [
            "@lint:check",
            "@analyse"
        ],
        "ci:test": [
            "@test"
        ],
        "ci": [
            "@ci:quality",
            "@ci:test"
        ],
        "ci:lowest": [
            "@composer update --prefer-lowest --prefer-stable --no-interaction --no-progress",
            "@ci:test",
            "@composer update --no-interaction --no-progress"
        ],
        "post-install-cmd": [
            "qa-install-hooks"
        ],
        "post-update-cmd": [
            "qa-install-hooks"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Porrodev/laravel-connector/issues",
        "source": "https://github.com/Porrodev/laravel-connector"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/1994limited/coding-standard"
        }
    ]
}
